{
  "name": "flat-planner",
  "version": "0.2.0",
  "description": "Plan furniture in your real flat with an AI agent: sketch, photos and tape become a measured 3D model; layouts are checked against walkway, door-swing and clearance rules.",
  "keywords": [
    "floor-plan",
    "furniture",
    "interior",
    "three.js",
    "claude-code",
    "ai-agent"
  ],
  "license": "MIT",
  "author": "khdoex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khdoex/flat-planner.git"
  },
  "homepage": "https://github.com/khdoex/flat-planner#readme",
  "type": "module",
  "bin": {
    "flat-planner": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "src",
    "index.html",
    "examples",
    ".claude/skills/survey/format.md"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx bin/cli.ts dev",
    "survey": "tsx bin/cli.ts survey",
    "check": "tsx bin/cli.ts check",
    "snap": "tsx bin/cli.ts snap",
    "typecheck": "tsc --noEmit",
    "build": "esbuild bin/cli.ts --bundle --platform=node --format=esm --packages=external --banner:js='#!/usr/bin/env node' --outfile=dist/cli.mjs",
    "prepack": "npm run typecheck && npm run build",
    "optimise": "tsx bin/cli.ts optimise",
    "plugin:zip": "sh scripts/pack-plugin.sh"
  },
  "dependencies": {
    "playwright": "^1.62.0",
    "polygon-clipping": "^0.15.7",
    "three": "^0.186.1",
    "vite": "^8.3.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
